<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.portfolio.banking</groupId>
    <artifactId>banking-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>banking-platform</name>
    <description>Portfolio banking platform built with an SOA architecture on Spring Boot</description>

    <modules>
        <module>common</module>
        <module>account-service</module>
        <module>transaction-service</module>
        <module>notification-service</module>
        <module>auth-service</module>
        <module>api-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <!-- Keeps parameter names in the bytecode. spring-boot-starter-parent
             turns this on for you; we import the BOM instead of inheriting the
             parent, so we have to ask for it ourselves. Jackson needs it to bind
             JSON onto constructor parameters (how event payloads get read back
             on the consumer side), and Spring needs it to resolve @Value /
             @PathVariable names without repeating them as annotation strings. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.4</spring-boot.version>
        <!-- Not managed by the imported spring-boot-dependencies BOM (that
             only pins dependency versions, and we don't inherit
             spring-boot-starter-parent's plugin management). Matched to
             surefire's version so the two behave identically. -->
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
        <!-- Newer than what spring-boot-dependencies:3.3.4 pins (1.19.8).
             Doesn't fully fix it, but it's a strictly newer, otherwise
             harmless version - see "Integration tests" in the README for
             the actual Docker Desktop compatibility issue this project hits
             on Windows. Spring Boot's BOM exposes this property for exactly
             this kind of override; see the testcontainers-bom import below
             for why the property alone isn't enough. -->
        <testcontainers.version>1.21.3</testcontainers.version>
        <!-- Release train aligned with Boot 3.3.x, for api-gateway's
             spring-cloud-starter-gateway. -->
        <spring-cloud.version>2023.0.3</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Declared BEFORE spring-boot-dependencies so it wins on the
                 shared org.testcontainers:* coordinates ("first import wins"
                 for a given GA across multiple imported BOMs). Overriding the
                 testcontainers.version property alone doesn't work here:
                 spring-boot-dependencies pulls in testcontainers-bom via its
                 OWN nested import, and that nested import is resolved (and
                 the version placeholder baked into a concrete number) while
                 building spring-boot-dependencies' own effective model,
                 before our project ever sees it - a property we set has
                 nothing left to substitute into by that point. Importing the
                 BOM ourselves, ahead of it, is what actually wins. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.portfolio.banking</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <!-- Version only, no executions here on purpose: the plugin
                     lifecycle runs verify BEFORE install, so binding these
                     executions unconditionally would make plain `mvn install`
                     - the routine build command - start a Docker daemon on
                     every run. The `integration-tests` profile below is what
                     actually wires the goals in, opt-in only. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- `mvn verify -Pintegration-tests` (or `install`/`package` with the
             same flag) runs *IT.java classes against real Testcontainers.
             Without this profile, `mvn test` and `mvn install` never touch
             Docker at all - see "Integration tests" in the README. -->
        <profile>
            <id>integration-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
